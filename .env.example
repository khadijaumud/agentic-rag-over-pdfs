# Environment Configuration for Agentic RAG
# Duplicate this file as .env and provide your API key(s)

# Primary LLM API Key (Google AI Studio - Free Tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback LLM (Groq - Free Tier available)
GROQ_API_KEY=your_groq_api_key_here

# Models
PRIMARY_LLM_MODEL=gemini-2.5-flash
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Retrieval Settings
DB_PATH=data/rag_database.db
DATA_DIR=data
PDF_DIR=starter/data/pdfs
TOP_K_DENSE=10
TOP_K_LEXICAL=10
RRF_K=60
RERANK_TOP_N=5
RELEVANCE_THRESHOLD=0.05

# Agent Limits
MAX_AGENT_ITERATIONS=6
PER_TURN_BUDGET_USD=0.05
MAX_USER_BUDGET_USD=5.0
